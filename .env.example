# Variable names only. Supply your own values through private environment
# configuration. Replit normally supplies these through its Secrets tool.
# Do not commit a filled-in copy.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
GOOGLE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
OWNER_EMAIL=

# Public frontend business contact configuration; not a credential.
VITE_OWNER_PHONE=

# Per-process runtime configuration.
# API: PORT=8080
# Website: PORT=5173 and BASE_PATH=/
PORT=
BASE_PATH=
NODE_ENV=
LOG_LEVEL=

# Replit connector authentication is supplied by the platform.
# No connector tokens, account identities, or connection secrets are exported.